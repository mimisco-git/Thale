# ===========================================================
# Thales — Arc Testnet Production Config
# ===========================================================

# ---- Required: AI ----
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ---- Required: Arc Testnet ----
# Chain ID: 5042002 | RPC: https://rpc.testnet.arc.network
# Explorer: https://testnet.arcscan.app
# Faucet: https://faucet.circle.com/

# Private key for autonomous on-chain execution (0x prefixed).
# Fund it via Circle Faucet: https://faucet.circle.com/
ARC_PRIVATE_KEY="0x..."

# Optional: override default Arc RPC (defaults to public testnet endpoint)
# ARC_RPC_URL="https://rpc.testnet.arc.network"

# ---- Optional: Circle APIs ----
# Get from https://app.circle.com/settings/developer
# Used for: Programmable Wallets (real wallet creation)
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""

# ---- Key Contract Addresses (Arc Testnet) ----
# These are hardcoded in arcClient.ts — no need to set unless using mainnet.
# USDC:             0x3600000000000000000000000000000000000000
# USYC:             0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
# USYC Teller:      0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
# CCTP Messenger:   0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA  (domain 26)
# Gateway Wallet:   0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# StableFX Escrow:  0x867650F5eAe8df91445971f14d89fd84F0C9a9f8
# EURC:             0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ---- Deployed Contract (after you deploy AgoraEconomicRouter) ----
# Run: npx hardhat run scripts/deploy.ts --network arc-testnet
AGORA_ROUTER_ADDRESS=""

# ---- App ----
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ---- Vercel Cron (for autonomous agent) ----
CRON_SECRET="any-random-string-you-choose"
FIREBASE_PROJECT_ID="gen-lang-client-0991308438"
